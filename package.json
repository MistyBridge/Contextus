{
  "name": "contextus",
  "version": "0.1.0",
  "description": "Contextus — Git Twin 会话状态运行时（MVP：Git Twin + 策略 Chunk + Session Tree）",
  "type": "module",
  "bin": { "sm": "./dist/index.js" },
  "scripts": {
